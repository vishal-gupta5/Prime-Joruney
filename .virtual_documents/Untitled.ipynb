import numpy as np
import time


# Execution performace
size = 100_000_000

# Python List
py_list = list(range(size))
start = time.time()
sq = [x ** 2 for x in py_list]
end = time.time()
print(f"Python list time = {end - start} seconds")

# Numpy Array
np_arr = np.array(py_list)
start = time.time()
sq_array = np_arr ** 2
end = time.time()
print(f"Numpy array time = {end - start} seconds")



