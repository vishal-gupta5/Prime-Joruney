#Pie Chart
expenses = ["Salaries", "Rent", "Marketing", "R&D", "Miscellaneous"]
amounts = [500, 150, 120, 100, 50]

explode = [0, 0, 0, 0.1, 0]



plt.pie(amounts, labels=expenses, autopct="%1.1f%%",
           wedgeprops = {
                "edgecolor": "black",
               "linewidth": 1,
               "linestyle": "-"
           },
        explode = explode,
        startangle = 45
       )

plt.show()


import numpy as np
import matplotlib.pyplot as plt

np.random.seed(0)
scores = np.random.normal(70, 10, 100)
bins = [0, 30, 70, 90, 100]

plt.hist(scores, color="aqua", edgecolor="black", bins=bins)
plt.xlabel("Scores")
plt.ylabel("X of students")



marks = [
    25, 38, 42, 55, 61, 67, 72, 78, 83, 88,
    91, 95, 47, 53, 59, 64, 69, 74, 79, 85,
    92, 97, 33, 45, 58, 62, 71, 76, 81, 89
]

plt.axvline(
    x = 33,
    linestyle = "--",
    color = "red",
    label = "Passing marks (33)",

)

plt.hist(marks, color="aqua", edgecolor="black", bins=bins)
plt.ylabel("Number of students")
plt.xlabel("marks")
plt.title("Distribution of marks of 30 Students")
plt.legend()


# Multiple datasets
legit_transactions = [
    2.99, 5.49, 8.99, 12.50, 14.99, 19.99, 23.45, 29.99, 34.99, 39.50,
    45.00, 49.99, 55.25, 60.00, 75.99, 89.99, 120.50, 150.00, 199.99,
    249.99, 300.75, 450.00, 600.00, 850.00, 1200.00
]

fraud_transactions = [
    50, 100, 150, 200, 300, 500, 500, 750, 1000, 1000,
    1200, 1500, 1500, 2000, 2500, 3000, 3000
]

# Transaction Amount Distribution: Legitimate vs Fraudulent
plt.hist(fraud_transactions, color="red", bins = 20, label = "Fraud", alpha = 0.5)
plt.hist(legit_transactions, color="green", bins = 20, label = "Legit", alpha = 0.5)

plt.title("Transaction Amount Distribution: Legit vs Fraud")
plt.xlabel("Amount (In $)")
plt.ylabel("Frequency")
plt.grid(True)
plt.legend()



